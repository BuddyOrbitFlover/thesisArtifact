            "    public void testRemoveLocalVariable$catena_6() throws Exception {\n        MethodGen mg = getMethod(Foo.class, \"bar\");\n\n        LocalVariableGen lv = mg.getLocalVariables()[1];\n        try{ assertEquals(\"variable name\", \"a\", lv.getName());                                                                       }catch(Throwable __SHOULD_BE_IGNORED){}\n        InstructionHandle start = lv.getStart();\n        InstructionHandle end = lv.getEnd();\n        try{ assertNotNull(\"scope start\", start);                                                                                    }catch(Throwable __SHOULD_BE_IGNORED){}\n        try{ assertNotNull(\"scope end\", end);                                                                                        }catch(Throwable __SHOULD_BE_IGNORED){}\n        try{ assertTrue(\"scope start not targeted by the local variable\", Arrays.asList(start.getTargeters()).contains(lv));         }catch(Throwable __SHOULD_BE_IGNORED){}\n        try{ assertTrue(\"scope end not targeted by the local variable\", Arrays.asList(end.getTargeters()).contains(lv));             }catch(Throwable __SHOULD_BE_IGNORED){}\n\n        // now let's remove the local variable\n        mg.removeLocalVariable(lv);\n\n        try{ assertFalse(\"scope start still targeted by the removed variable\", Arrays.asList(start.getTargeters()).contains(lv));    }catch(Throwable __SHOULD_BE_IGNORED){}\n        assertFalse(\"scope end still targeted by the removed variable\", Arrays.asList(end.getTargeters()).contains(lv));             /***** ORIGINAL ASSERTION IS HERE *****/\n        try{ assertNull(\"scope start\", lv.getStart());                                                                               }catch(Throwable __SHOULD_BE_IGNORED){}\n        try{ assertNull(\"scope end\", lv.getEnd());                                                                                   }catch(Throwable __SHOULD_BE_IGNORED){}\n    }",
